{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "rootDir": ".",
    "strict": true,
    "target": "ES2023"
  },
  "exclude": [
    ".git",
    "api-docs",
    "benchmarks/results",
    "coverage",
    "dist",
    "docs/.blume",
    "docs/.blume-verify",
    "docs/dist",
    "docs/node_modules",
    "node_modules"
  ],
  "include": [
    ".claude/hooks/**/*.mts",
    "benchmarks/**/*.js",
    "benchmarks/**/*.mjs",
    "bin/**/*.mjs",
    "docs/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.mts",
    "scripts/**/*.ts",
    "services/**/*.ts",
    "src/**/*.ts"
  ]
}
