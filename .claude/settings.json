{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-session-start.mts"
            ],
            "statusMessage": "Refreshing agent hook state",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-user-prompt-submit.mts"
            ],
            "statusMessage": "Checking prompt-scoped supaschema context",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Bash|Edit|Glob|Grep|MultiEdit|NotebookEdit|Read|Task|WebFetch|WebSearch|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-pre-tool-use.mts"
            ],
            "statusMessage": "Checking required supaschema context",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/supaschema-source-hook.mts",
              "hook",
              "generated-artifact-edit",
              "--runtime",
              "claude"
            ],
            "statusMessage": "Checking supaschema generated-artifact policy",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-post-tool-use.mts"
            ],
            "statusMessage": "Recording supaschema hook evidence",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/supaschema-source-hook.mts",
              "hook",
              "schema-write"
            ],
            "statusMessage": "Running supaschema auto-diff on schema change",
            "timeout": 130
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-post-tool-use-failure.mts"
            ],
            "statusMessage": "Recording failed supaschema hook evidence",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-subagent-start.mts"
            ],
            "statusMessage": "Loading supaschema subagent context",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-task-completed.mts"
            ],
            "statusMessage": "Checking required supaschema skills",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/context-stop.mts"],
            "statusMessage": "Checking supaschema final-response evidence",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-subagent-stop.mts"
            ],
            "statusMessage": "Checking supaschema subagent closeout",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-session-end.mts"
            ],
            "statusMessage": "Clearing supaschema agent hook state",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(git add:*)"],
    "deny": ["Read(*.env)", "Bash(rm:*)", "Bash(curl:*)"],
    "defaultMode": "bypassPermissions"
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
